# ==========================================
# 1. System Files (Never track these!)
# ==========================================
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# 2. Node.js / JavaScript (React, Vue, Express)
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==========================================
# 3. Python (Django, Flask, FastAPI)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.env

# ==========================================
# 4. Build & Output Folders
# ==========================================
dist/
build/
out/
.next/

# ==========================================
# 5. IDE / Code Editor Settings
# ==========================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
backend/.env
